rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'hilzmg70@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidSong(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.artist is string && data.artist.size() <= 200 &&
             data.category in ['Single', 'Album', 'Gospel', 'Hip Hop', 'Zambian', 'RnB', 'Dancehall', 'Afrobeat', 'Kalindula'] &&
             (!('archiveLink' in data) || (data.archiveLink is string && data.archiveLink.size() <= 1000)) &&
             (!('imageBase64' in data) || (data.imageBase64 is string && data.imageBase64.size() <= 700000)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
             (!('tracks' in data) || (data.tracks is list && data.tracks.size() <= 50)) &&
             (!('views' in data) || (data.views is string)) &&
             (!('createdAt' in data) || (data.createdAt == request.time || (resource != null && data.createdAt == resource.data.createdAt)));
    }

    function isValidArtist(data) {
      return data.name is string && data.name.size() <= 200 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 5000)) &&
             (!('imageBase64' in data) || (data.imageBase64 is string && data.imageBase64.size() <= 700000)) &&
             (!('createdAt' in data) || (data.createdAt == request.time || (resource != null && data.createdAt == resource.data.createdAt)));
    }

    function isValidSettings(data) {
      return data.siteName is string && data.siteName.size() <= 100 &&
             data.siteBio is string && data.siteBio.size() <= 500 &&
             (!('logoBase64' in data) || (data.logoBase64 is string)) &&
             (!('underConstruction' in data) || (data.underConstruction is bool)) &&
             (!('updatedAt' in data) || (data.updatedAt == request.time || data.updatedAt == null));
    }

    // --- Collections ---

    match /songs/{songId} {
      allow read: if true; // Public read access for songs
      allow create: if isAdmin() && isValidSong(incoming());
      allow update: if isAdmin() && isValidSong(incoming());
      allow delete: if isAdmin();
    }

    match /artists/{artistId} {
      allow read: if true; // Public read access for artists
      allow create: if isAdmin() && isValidArtist(incoming());
      allow update: if isAdmin() && isValidArtist(incoming());
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true; // Public read access for settings
      allow write: if isAdmin() && isValidSettings(incoming());
    }
  }
}
